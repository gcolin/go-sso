<h1>{{t.loginEmail.heading}}</h1>
<p class="hint">{{t.loginEmail.hint}}</p>
{{> alerts}}

<form method="post" action="{{basePath}}/login/email">
  {{> csrfField}}
  <input type="hidden" name="returnUrl" value="{{returnUrl}}"/>
  {{#clientId}}<input type="hidden" name="clientId" value="{{clientId}}"/>{{/clientId}}
  <label for="email">{{t.login.email}}
    <input id="email" name="email" type="email" required autocomplete="username" value="{{formEmailValue}}"/>
  </label>
  <button type="submit">{{t.loginEmail.submit}}</button>
</form>

<p class="after-form">
  <a href="{{basePath}}/login?returnUrl={{returnUrlEncoded}}{{#clientId}}&amp;clientId={{clientId}}{{/clientId}}">{{t.loginEmail.backLogin}}</a>
</p>
