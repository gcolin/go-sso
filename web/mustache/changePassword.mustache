<article class="panel">
  {{#creatingPassword}}
  <h1>{{t.password.createHeading}}</h1>
  <p class="hint">{{t.password.createHint}}</p>
  {{/creatingPassword}}
  {{^creatingPassword}}
  <h1>{{t.password.heading}}</h1>
  <p class="hint">{{t.password.hint}}</p>
  {{/creatingPassword}}
  {{> alerts}}

  <form method="post" action="{{basePath}}/profile/password">
    {{> csrfField}}
    {{#hasLocalPassword}}
    <label for="currentPassword">{{t.password.current}}
      <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password"/>
    </label>
    {{/hasLocalPassword}}
    <label for="newPassword">{{#creatingPassword}}{{t.password.createNew}}{{/creatingPassword}}{{^creatingPassword}}{{t.password.new}}{{/creatingPassword}}
      <input id="newPassword" name="newPassword" type="password" required autocomplete="new-password"
             placeholder="{{t.password.placeholder}}"/>
    </label>
    <label for="confirmPassword">{{t.password.confirm}}
      <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password"/>
    </label>
    <div class="page-actions">
      <button type="submit">{{#creatingPassword}}{{t.password.create}}{{/creatingPassword}}{{^creatingPassword}}{{t.password.save}}{{/creatingPassword}}</button>
      <a role="button" class="secondary" href="{{basePath}}/profile">{{t.password.backProfile}}</a>
    </div>
  </form>

  {{#canRemovePassword}}
  <hr/>
  <h2>{{t.password.removeHeading}}</h2>
  <p class="hint">{{t.password.removeHint}}</p>
  {{#totpEnabled}}
  <p class="hint">{{t.password.removeAlso2fa}}</p>
  {{/totpEnabled}}
  <form method="post" action="{{basePath}}/profile/password/remove"
        data-confirm="{{removePasswordConfirm}}">
    {{> csrfField}}
    <div class="page-actions">
      <button type="submit" class="contrast">{{t.password.remove}}</button>
    </div>
  </form>
  {{/canRemovePassword}}
  {{#hasLocalPassword}}
  {{^canRemovePassword}}
  <hr/>
  <p class="hint">{{t.password.removeNeedsFederation}}</p>
  {{/canRemovePassword}}
  {{/hasLocalPassword}}
</article>
