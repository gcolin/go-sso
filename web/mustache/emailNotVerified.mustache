<h1>{{t.emailNotVerified.heading}}</h1>
<p class="alert alert-error" role="alert">{{notVerifiedMessage}}</p>
{{> alerts}}

<form method="post" action="{{basePath}}/verify-email/resend">
  {{> csrfField}}
  <input type="hidden" name="email" value="{{email}}"/>
  <input type="hidden" name="returnUrl" value="{{returnUrl}}"/>
  <input type="hidden" name="pending" value="1"/>
  <button type="submit">{{t.login.resendVerification}}</button>
</form>

<p class="after-form">
  <a href="{{basePath}}/?returnUrl={{returnUrlEncoded}}">{{t.register.backLogin}}</a>
</p>
